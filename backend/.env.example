PORT=4000

# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the example below in a real deployment.
JWT_SECRET=change_this_to_a_long_random_string

# From your Supabase project: Settings -> Database -> Connection string -> URI
# (select "Nodejs" / the non-pooled URI for a long-running server like this one)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Signup control. The very first person to register always gets through
# (so you're never locked out of a fresh deployment) and becomes admin.
# After that:
#   REGISTRATION_OPEN=true   -> anyone can register, no invite needed
#   REGISTRATION_OPEN=false  -> registration requires INVITE_CODE below
REGISTRATION_OPEN=false
INVITE_CODE=change_this_to_something_only_your_team_knows
